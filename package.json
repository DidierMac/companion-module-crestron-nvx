{
	"name": "companion-module-crestron-nvx",
	"version": "0.1.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"pretest": "tsc -p tsconfig.json --noEmit",
		"test": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs --test src/*.test.ts src/**/*.test.ts scripts/uat/*.test.ts scripts/uat/**/*.test.ts",
		"uat:journey": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs scripts/uat/journey/run-journey.ts",
		"uat:fake": "UAT_PROFILE=fake npm run uat:journey",
		"uat:local": "UAT_PROFILE=local npm run uat:journey",
		"uat:fake-device": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs scripts/uat/fake-device/server.ts",
		"uat:adjudicate": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs scripts/uat/adjudicate.ts",
		"lint": "eslint .",
		"format": "prettier -w ."
	},
	"keywords": [
		"companion",
		"crestron",
		"nvx"
	],
	"license": "MIT",
	"dependencies": {
		"@companion-module/base": "^2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22",
		"eslint": "^9",
		"prettier": "^3",
		"typescript": "~5.8"
	},
	"engines": {
		"node": ">=22"
	}
}

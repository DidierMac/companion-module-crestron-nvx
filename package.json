{
	"name": "companion-module-crestron-nvx",
	"version": "0.1.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"pretest": "tsc -p tsconfig.json --noEmit",
		"test": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs --test src/*.test.ts src/**/*.test.ts scripts/uat/*.test.ts scripts/uat/**/*.test.ts",
		"uat": "node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs scripts/uat/run.ts",
		"uat:tier0": "UAT_TIERS=0 node --experimental-transform-types --no-warnings --loader ./scripts/ts-resolver.mjs scripts/uat/run.ts",
		"lint": "eslint .",
		"format": "prettier -w ."
	},
	"keywords": ["companion", "crestron", "nvx"],
	"license": "MIT",
	"dependencies": {
		"@companion-module/base": "^2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22",
		"typescript": "~5.8",
		"eslint": "^9",
		"prettier": "^3"
	},
	"engines": {
		"node": ">=22"
	}
}
